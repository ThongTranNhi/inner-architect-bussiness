{
  "name": "inner-architect-server",
  "private": true,
  "version": "1.0.0",
  "description": "Backend tiếp nhận thông tin khách hàng và trang quản trị Customer Care của INNER ARCHITECT™",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "db:migrate": "tsx scripts/chay-migration.ts",
    "admin:create": "tsx scripts/tao-quan-tri-vien.ts"
  },
  "dependencies": {
    "argon2": "0.45.2",
    "express": "5.3.0",
    "express-mysql-session": "3.0.3",
    "express-rate-limit": "8.7.4",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "mysql2": "3.24.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/express-mysql-session": "3.0.8",
    "@types/express-session": "1.19.0",
    "@types/node": "22.19.17",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
