# Backend INNER ARCHITECT™ — sao chép thành server/.env rồi điền giá trị thật.
# KHÔNG commit server/.env. Không đặt secret vào biến VITE_* (sẽ lộ ra trình duyệt).

NODE_ENV=development
HOST=127.0.0.1
PORT=3001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inner_architect_db
# Tài khoản ứng dụng: chỉ SELECT, INSERT, UPDATE, DELETE trên inner_architect_db.*
DB_USER=inner_architect_app
DB_PASSWORD=

# Tài khoản migration (CREATE, ALTER, INDEX, REFERENCES + DML; không DROP). Bỏ trống thì dùng DB_USER.
DB_MIGRATE_USER=inner_architect_migrator
DB_MIGRATE_PASSWORD=

# Database riêng cho test tích hợp (pnpm test:server). Test xóa dữ liệu trong database này.
TEST_DB_NAME=inner_architect_test

# Chuỗi ngẫu nhiên >= 32 ký tự, ví dụ: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Thời hạn phiên đăng nhập quản trị (giờ)
SESSION_MAX_AGE_HOURS=8

# Origin được phép gửi POST/PATCH (phân tách bằng dấu phẩy). Production: https://innerarchitect.vn
ALLOWED_ORIGINS=http://localhost:8443,http://127.0.0.1:8443
# true khi chạy sau Nginx (một proxy) để lấy đúng IP client và bật cookie Secure
TRUST_PROXY=false
